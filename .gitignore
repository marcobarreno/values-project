msm/data/
msm/models/*
!msm/models/download.sh
!msm/models/hf_manifest.json
msm/runs/
# Paper PDFs: fetch from arXiv (IDs in README.md)
msm/docs/*.pdf

# Python / tooling / editor
__pycache__/
*.py[cod]
.pytest_cache/
*~
.#*
