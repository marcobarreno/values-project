# Local-only files (never committed)
private/
CLAUDE.local.md
.claude/settings.local.json
.env
.env.*

# Third-party code, fetched at pinned commits by scripts/fetch_external.sh
external/

# Environments, downloaded artifacts and run outputs (large; regenerable)
